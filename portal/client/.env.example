# RightServe Portal — Frontend configuration
# Copy to ".env" and adjust before building (npm run build).

# Backend API base URL.
#  - Leave EMPTY when the API and the frontend are served from the SAME server.
#  - Set to the API server's public URL when they are on DIFFERENT servers, e.g.
#      VITE_API_BASE=https://api.rightserve.com
# Do NOT add a trailing slash and do NOT include the "/api" suffix.
VITE_API_BASE=
