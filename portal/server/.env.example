# RightServe Portal — Backend (API) configuration
# Copy to ".env" (the app reads process.env; use a process manager or a tool
# like dotenv / your host's env settings to load these).

# Port the API listens on.
PORT=4100

# Bind address. 0.0.0.0 = reachable from outside (needed on a cloud server).
HOST=0.0.0.0

# JWT signing secret — MUST be a long random string in production.
PORTAL_JWT_SECRET=change-this-to-a-long-random-secret

# Where the SQLite database file lives (use a persistent disk on cloud).
PORTAL_DB_PATH=./data/portal.db

# Allowed frontend origin(s) for CORS, comma-separated. REQUIRED when the
# frontend is on a different domain than this API. Leave empty to allow all.
#   CORS_ORIGIN=https://portal.rightserve.com
CORS_ORIGIN=

# Activation server URL stamped into newly generated license keys. This is the
# PUBLIC URL of THIS API server that desktop apps call to activate. You can
# change it any time after deployment; only keys generated afterwards use it.
#   ACTIVATION_URL=https://api.rightserve.com
ACTIVATION_URL=

# Path to the ed25519 private key used to sign licenses (keep secret!).
# LICENSE_PRIVATE_KEY=./license_private.pem

# Optional: directory of the built frontend if you serve it from THIS server
# (single-server deploy). Leave unset when the frontend is hosted separately.
# PORTAL_CLIENT_DIST=../client/dist
